{
  "name": "udit-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://gitudit.github.io/udit-portfolio/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr-build && node --disable-warning=ExperimentalWarning scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"./src/**/*.{ts,tsx,css}\" \"./scripts/*.mjs\" \"./*.{mjs,js,json}\"",
    "deploy": "node scripts/deploy.mjs --domain uditsingh.com",
    "deploy:pages": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "email-validator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "oxc-transform-react": "^0.154.0",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
