{
  "name": "udit-portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://gitudit.github.io/udit-portfolio/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr-build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build --dotfiles",
    "format": "prettier --write \"./src/**/*.{js,jsx,css}\" \"./scripts/*.mjs\"",
    "fonts:subset": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "colorthief": "^2.4.0",
    "email-validator": "^2.0.4",
    "emailjs-com": "^3.2.0",
    "lottie-web": "5.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-headroom": "^3.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.6.2",
    "subset-font": "^2.9.0",
    "vite": "^6.4.4"
  },
  "type": "module"
}
